<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GammaCnf.App.App" RequestedThemeVariant="Light">
 <Application.Styles>
  <FluentTheme/>
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
  <Style Selector="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  <Style Selector="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Application.Styles>
</Application>
