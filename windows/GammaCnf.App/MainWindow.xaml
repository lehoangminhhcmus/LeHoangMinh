<Window x:Class="GammaCnf.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GammaCnf.App" Title="Gamma CNF Reader" Width="1220" Height="800" MinWidth="850" MinHeight="560" Background="#F3F6FB" FontFamily="Segoe UI" FontSize="14" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnKeyDown">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <StackPanel DockPanel.Dock="Left" Margin="0,0,30,0"><TextBlock Text="GAMMA / CNF" FontSize="26" FontWeight="Bold" Foreground="#112C4C"/><TextBlock Text="Canberra spectrum viewer" Foreground="#60758B" FontSize="12"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="Mở file…" Click="OpenClick" Background="#165CB5" Foreground="White"/>
    <Button x:Name="CsvButton" Content="Xuất CSV" Click="CsvClick" IsEnabled="False"/>
    <Button x:Name="PngButton" Content="Lưu PNG" Click="PngClick" IsEnabled="False"/>
    <Button Content="Toàn phổ" Click="ResetClick"/>
    <CheckBox x:Name="EnergyCheck" Content="keV" IsEnabled="False" Checked="ModeChanged" Unchecked="ModeChanged"/>
    <CheckBox x:Name="LogCheck" Content="Log" Checked="ModeChanged" Unchecked="ModeChanged"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Padding="18,14" Margin="0,0,0,16" Background="White" CornerRadius="8" BorderBrush="#DFE6F0" BorderThickness="1">
   <StackPanel><TextBlock x:Name="FileLabel" Text="Chưa mở phổ" FontSize="17" FontWeight="SemiBold" Foreground="#112C4C" TextWrapping="Wrap"/><TextBlock x:Name="Metadata" Text="Chọn hoặc kéo thả file Canberra .CNF vào cửa sổ." Margin="0,6,0,0" Foreground="#52657B" TextWrapping="Wrap"/><TextBlock x:Name="CalibrationLabel" Foreground="#52657B" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
  </Border>
  <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#DFE6F0" BorderThickness="1" Padding="8"><local:SpectrumPlot x:Name="Plot"/></Border>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="Ctrl+O: mở file • Lăn chuột: zoom • Kéo chuột: chọn vùng • Home: toàn phổ" Foreground="#52657B" TextWrapping="Wrap"/><TextBlock x:Name="Warnings" Foreground="#A45E00" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>
