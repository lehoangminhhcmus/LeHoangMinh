<Window x:Class="GammaCnf.App.EfficiencyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GammaCnf.App" Title="Chuẩn hiệu suất và hoạt độ" Width="1400" Height="980" MinWidth="1150" MinHeight="760" Background="#F3F6FB" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,3,0,8"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10"><TextBlock Text="HIỆU SUẤT ĐỈNH TOÀN PHẦN" FontSize="21" FontWeight="Bold" Foreground="#112C4C"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Mở bộ chuẩn JSON…" Click="LoadProfileClick"/><Button Content="Lưu bộ chuẩn JSON…" Click="SaveProfileClick"/><Button Content="Xuất báo cáo chuẩn TXT…" Click="ExportProfileClick"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="White" Padding="12" Margin="0,0,0,10" CornerRadius="6">
   <StackPanel>
    <TextBlock x:Name="SpectrumLabel" FontWeight="SemiBold"/>
    <WrapPanel Margin="0,6,0,0">
     <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="Live time (s) * — từ CNF"/><TextBox x:Name="LiveText"/></StackPanel>
     <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="Real time (s; tùy chọn)"/><TextBox x:Name="RealText"/></StackPanel>
     <StackPanel Width="520"><TextBlock Text="ROI đã fit của phổ đang mở"/><ComboBox x:Name="RoiChoice" DisplayMemberPath="Label" Margin="0,3,0,8"/></StackPanel>
    </WrapPanel>

    <Expander x:Name="GeometryDetails" Header="Thông tin bộ chuẩn / ngày giờ (tùy chọn khi nhập gọn)" IsExpanded="False" Margin="0,5,0,0">
     <WrapPanel>
      <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="Detector / số máy (tùy chọn)"/><TextBox x:Name="DetectorText"/></StackPanel>
      <StackPanel Width="210" Margin="0,0,10,0"><TextBlock Text="Mã hình học (tùy chọn)"/><TextBox x:Name="GeometryText"/></StackPanel>
      <StackPanel Width="100" Margin="0,0,10,0"><TextBlock Text="Khoảng cách mm (tùy chọn)"/><TextBox x:Name="DistanceText"/></StackPanel>
      <StackPanel Width="290" Margin="0,0,10,0"><TextBlock Text="Ghi chú cấu hình (tùy chọn)"/><TextBox x:Name="GeometryNotes"/></StackPanel>
      <StackPanel Width="230"><TextBlock Text="Tên bộ chuẩn (tự đặt nếu trống)"/><TextBox x:Name="ProfileName"/></StackPanel>
      <StackPanel Width="310"><TextBlock Text="Đầu đo ISO + múi giờ (khi quy đổi ngày)"/><TextBox x:Name="MeasuredAt"/></StackPanel>
     </WrapPanel>
    </Expander>
   </StackPanel>
  </Border>
  <TabControl x:Name="Tabs" Grid.Row="2">
   <TabItem Header="1. Nguồn và điểm chuẩn">
    <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,14,0">

      <TextBlock Text="Nhập gọn để tính hiệu suất" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock Text="Chọn ROI phía trên; diện tích và live time lấy từ phổ. Chỉ cần hoạt độ nguồn và xác suất gamma. Để trống các thông tin bổ sung nếu chưa có." Margin="0,7"/>
      <TextBlock x:Name="ActivityBasisLabel" Text="Hoạt độ tại đầu phép đo (Bq) *"/><TextBox x:Name="ActivityText"/>
      <TextBlock Text="Năng lượng vạch keV (trống = tâm ROI)"/><TextBox x:Name="GammaEnergy"/>
      <TextBlock Text="Xác suất phát gamma (%) *"/><TextBox x:Name="GammaProbability"/>
      <TextBlock Text="Mặc định ε = Nđỉnh / (A × live time × Pγ). A đã quy đổi về đầu đo; không tự giảm hoạt độ lần nữa. Nếu không nhập bán rã, chưa hiệu chỉnh phân rã trong phép đo." Foreground="#9A5900" Margin="0,5,0,8"/>
      <CheckBox x:Name="UseCertificateDecay" Content="Tự quy đổi A từ ngày chứng nhận" Checked="ActivityModeChanged" Unchecked="ActivityModeChanged" Margin="0,5,0,10"/>
      <Expander x:Name="SourceDetails" Header="Thông tin bổ sung / phân rã / sai số" IsExpanded="False">
       <StackPanel>
        <TextBlock Text="Mọi ô bên dưới đều có thể để trống, trừ dữ liệu cần cho lựa chọn hiệu chỉnh phân rã. Sai số trống được đánh dấu chưa cung cấp; ± chỉ gồm các thành phần đã có." TextWrapping="Wrap" Foreground="#9A5900" Margin="0,8"/>
        <TextBlock Text="Mã nguồn (trống = mã nội bộ theo phép đo)"/><TextBox x:Name="SourceId"/>
        <TextBlock Text="Đồng vị (tùy chọn)"/><TextBox x:Name="SourceNuclide"/>
        <TextBlock Text="Chứng chỉ / đơn vị cấp (tùy chọn)"/><TextBox x:Name="CertificateText"/>
        <TextBlock Text="Sai số hoạt độ nguồn (%) — trống = chưa có"/><TextBox x:Name="ActivitySigmaText"/>
        <TextBlock Text="Hệ số phủ k (trống = 1; sai số đã là 1σ)"/><TextBox x:Name="ActivityCoverageText"/>
        <TextBlock Text="Ngày chứng nhận ISO + múi giờ (khi tự quy đổi A)"/><TextBox x:Name="ReferenceDateText"/>
        <TextBlock Text="Bán rã (ngày; trống = không hiệu chỉnh phân rã)"/><TextBox x:Name="HalfLifeText"/>
        <TextBlock Text="Sai số bán rã 1σ (ngày; tùy chọn)"/><TextBox x:Name="HalfLifeSigmaText"/>
        <TextBlock Text="Sai số Pγ 1σ (điểm phần trăm; tùy chọn)"/><TextBox x:Name="GammaSigma"/>
        <TextBlock Text="Tham chiếu Pγ / bán rã (tùy chọn)"/><TextBox x:Name="NuclearReference"/>
        <TextBlock Text="K nhân diện tích đỉnh (trống = 1)"/><TextBox x:Name="StandardCorrection"/>
        <TextBlock Text="Sai số tuyệt đối K 1σ (tùy chọn)"/><TextBox x:Name="StandardCorrectionSigma"/>
        <TextBlock Text="Căn cứ K (tùy chọn, nên ghi khi có hiệu chỉnh)"/><TextBox x:Name="StandardCorrectionNotes"/>
       </StackPanel>
      </Expander>
      <Button Content="Thêm ROI đã chọn làm điểm chuẩn" Click="AddPointClick" Margin="0,12,0,8"/>
     </StackPanel></ScrollViewer>
     <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DataGrid x:Name="PointsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="120"/>
        <DataGridTextColumn Header="keV" Binding="{Binding Energy}" Width="80"/>
        <DataGridTextColumn Header="ε (fraction)" Binding="{Binding Efficiency}" Width="110"/>
        <DataGridTextColumn Header="σ (%)" Binding="{Binding RelativeSigma}" Width="80"/>
        <DataGridTextColumn Header="ROI / phổ" Binding="{Binding Provenance}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="1" Margin="0,10,0,0"><WrapPanel><Button Content="Xóa điểm đang chọn" Click="RemovePointClick"/><Button Content="Xóa các điểm" Click="ClearPointsClick"/></WrapPanel>
       <TextBlock Text="Có thể gộp nhiều phổ/nguồn nếu cùng hình học: lưu bộ chuẩn rồi mở phổ khác, mở lại cửa sổ và thêm điểm. Không dùng ROI trùng/chồng của cùng phép đo làm điểm độc lập. Cùng mã nguồn phải giữ nguyên dữ liệu chứng chỉ." Margin="0,8"/>
      </StackPanel>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="2. Đường chuẩn và phần dư">
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel><TextBlock Text="Bậc đa thức ln ε theo ln(E/1000 keV):" VerticalAlignment="Center"/><ComboBox x:Name="DegreeChoice" Width="65" SelectedIndex="0" Margin="10,0"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/></ComboBox><Button Content="Fit đường chuẩn" Click="FitClick"/></WrapPanel>
     <TextBlock x:Name="FitSummary" Grid.Row="1" Text="Bậc 1–3 cần tối thiểu bậc+2 năng lượng khác nhau. Nên có nhiều điểm phân bố đều trong miền sử dụng." Margin="0,10"/>
     <local:EfficiencyPlot x:Name="CurvePlot" Grid.Row="2"/>
    </Grid>
   </TabItem>
   <TabItem Header="3. Tính hoạt độ mẫu">
    <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,14,0">
      <TextBlock Text="Dùng ROI và điều kiện phép đo ở phía trên. Cần phổ mẫu độc lập với các phổ đã dùng tạo bộ chuẩn." Margin="0,0,0,8"/>
      <CheckBox x:Name="GeometryConfirmed" Margin="0,5,0,12"><TextBlock Text="Tôi đã kiểm tra mẫu khớp detector, hình học, khoảng cách và cấu hình của bộ chuẩn"/></CheckBox>
      <TextBlock Text="Đồng vị của mẫu"/><TextBox x:Name="SampleNuclide"/>
      <TextBlock Text="Năng lượng vạch (keV)"/><TextBox x:Name="SampleEnergy"/>
      <TextBlock Text="Xác suất phát gamma (%)"/><TextBox x:Name="SampleProbability"/>
      <TextBlock Text="Sai số xác suất 1σ (điểm phần trăm)"/><TextBox x:Name="SampleProbabilitySigma"/>
      <TextBlock Text="Nguồn dữ liệu Pγ và bán rã / phiên bản"/><TextBox x:Name="SampleNuclearReference"/>
      <TextBlock Text="Chu kỳ bán rã (ngày)"/><TextBox x:Name="SampleHalfLife"/>
      <TextBlock Text="Sai số bán rã 1σ (ngày)"/><TextBox x:Name="SampleHalfLifeSigma"/>
      <TextBlock Text="Ngày quy chiếu ISO + múi giờ (để trống = đầu đo)"/><TextBox x:Name="ReportDateText"/>
      <TextBlock Text="Hệ số nhân hoạt độ K (1 = không hiệu chỉnh)"/><TextBox x:Name="CorrectionText" Text="1"/>
      <TextBlock Text="Sai số tuyệt đối của K (1σ)"/><TextBox x:Name="CorrectionSigmaText" Text="0"/>
      <TextBlock Text="Căn cứ K / hiệu chỉnh đã áp dụng"/><TextBox x:Name="CorrectionNotes"/>
      <TextBlock Text="Khối lượng (kg; trống = chỉ tính Bq)"/><TextBox x:Name="MassText"/>
      <TextBlock Text="Sai số khối lượng (kg, 1σ)"/><TextBox x:Name="MassSigmaText" Text="0"/>
      <Button Content="Tính hoạt độ ROI" Click="CalculateClick" Margin="0,8,0,8"/>
      <Button Content="Xuất báo cáo hoạt độ TXT…" Click="ExportActivityClick"/>
     </StackPanel></ScrollViewer>
     <Border Grid.Column="1" Background="White" Padding="18"><StackPanel><TextBlock Text="Kết quả và điều kiện áp dụng" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ActivitySummary" Text="Mở hoặc tạo đường chuẩn, chọn ROI mẫu rồi nhập dữ liệu vạch gamma để tính." Margin="0,14" FontSize="16"/><TextBlock Text="App chưa tự tính tự hấp thụ, trùng phùng tổng, suy giảm vật liệu hoặc hiệu chỉnh hình học. K chỉ là hệ số do người dùng cung cấp có căn cứ; không thay thế đường chuẩn đúng hình học. Chưa gộp các vạch thành một hoạt độ đồng vị. Với phổ ít số đếm/đỉnh chồng, cần kiểm tra phương pháp fit ROI." Foreground="#9A5900"/></StackPanel></Border>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock x:Name="StatusText" Grid.Row="3" Text="Nhập gọn: chọn ROI → hoạt độ tại đầu đo (Bq) → xác suất gamma (%) → thêm điểm. Các mục bổ sung được phép để trống." Margin="0,10,0,0" Foreground="#52657B"/>
 </Grid>
</Window>
